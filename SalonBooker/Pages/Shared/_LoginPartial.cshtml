@using Microsoft.AspNetCore.Identity
@using SalonBooker.Models
@using Microsoft.EntityFrameworkCore
@using SalonBooker.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var currentUser = await UserManager.GetUserAsync(User);
    bool isBarber = false;
    bool isAdmin = false;

    if (currentUser != null)
    {
        isBarber = await DbContext.Barbers.AnyAsync(b => b.UserId == currentUser.Id);
        isAdmin = await UserManager.IsInRoleAsync(currentUser, "Admin");
    }
}

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        // Начало за всички логнати
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Index">Начало</a>
        </li>

        // Админ бутон (само за администратори)
        @if (isAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold" asp-page="/Admin/Index">🔧 Админ панел</a>
            </li>
        }

        if (isBarber)
        {
            // Меню за фризьор
            <li class="nav-item">
                <a class="nav-link text-dark" asp-page="/Appointments/Today">Днешните часове</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">Профил</a>
            </li>
            <li class="nav-item">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                    <button type="submit" class="nav-link btn btn-link text-dark">Изход</button>
                </form>
            </li>
        }
        else
        {
            // Меню за обикновен клиент
            <li class="nav-item">
                <a class="nav-link text-dark" asp-page="/Appointments/MyAppointments">Моите часове</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">Профил</a>
            </li>
            <li class="nav-item">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                    <button type="submit" class="nav-link btn btn-link text-dark">Изход</button>
                </form>
            </li>
        }
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    }
</ul>