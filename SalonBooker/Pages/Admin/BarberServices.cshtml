@page "{barberId:int}"
@model SalonBooker.Pages.Admin.BarberServicesModel
@{
    ViewData["Title"] = "Услуги на фризьор";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>✂️ Услуги на @Model.BarberName</h2>
        <a asp-page="./Barbers" class="btn btn-secondary">← Назад</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Текущи услуги -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">📋 Текущи услуги</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.CurrentServices.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Услуга</th>
                                    <th>Цена</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var service in Model.CurrentServices)
                                {
                                    <tr>
                                        <td>@service.Name</td>
                                        <td>@service.Price лв.</td>
                                        <td>
                                            <form method="post" asp-page-handler="Remove">
                                                <input type="hidden" name="barberId" value="@Model.BarberId" />
                                                <input type="hidden" name="serviceId" value="@service.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Махни услугата?')">
                                                    ❌ Махни
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted p-3 mb-0">Няма добавени услуги.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Добавяне на услуга -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">➕ Добави услуга</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.AvailableServices.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Услуга</th>
                                    <th>Цена</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var service in Model.AvailableServices)
                                {
                                    <tr>
                                        <td>@service.Name</td>
                                        <td>@service.Price лв.</td>
                                        <td>
                                            <form method="post" asp-page-handler="Add">
                                                <input type="hidden" name="barberId" value="@Model.BarberId" />
                                                <input type="hidden" name="serviceId" value="@service.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    ✅ Добави
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted p-3 mb-0">Всички услуги са добавени.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>