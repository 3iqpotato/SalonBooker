@page
@model SalonBooker.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Управление на потребители";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Управление на потребители</h2>
        <a asp-page="./Index" class="btn btn-secondary">← Назад</a>
    </div>

    <!-- Търсачка -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-3">
                    <div class="col-md-8">
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="Търси по име, имейл или телефон..."
                               value="@Model.SearchTerm" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">🔍 Търси</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Списък с потребители -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Пълно име</th>
                            <th>Имейл</th>
                            <th>Телефон</th>
                            <th>Точки</th>
                            <th>Статус</th>
                            <th>Роля</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                                <td><span class="badge bg-warning text-dark">@user.Points</span></td>
             
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Блокиран</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    @if (user.IsBarber)
                                    {
                                        <span class="badge bg-warning text-dark">Фризьор</span>
                                    }
                                    @if (!user.IsAdmin && !user.IsBarber)
                                    {
                                        <span class="badge bg-secondary">Клиент</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="ToggleActive" style="display:inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Блокиране на потребителя?')">
                                                🔒 Блокирай
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success btn-sm"
                                                    onclick="return confirm('Отблокиране на потребителя?')">
                                                🔓 Отблокирай
                                            </button>
                                        }
                                    </form>

                                    <form method="post" asp-page-handler="AddPoints" style="display:inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-success btn-sm"
                                                onclick="return confirm('Добави 10 точки?')">
                                            ⭐ +10
                                        </button>
                                    </form>

                                    <form method="post" asp-page-handler="RemovePoints" style="display:inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-warning btn-sm"
                                                onclick="return confirm('Махни 10 точки?')">
                                            ➖ -10
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Пагинация -->
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Users"
                                   asp-route-currentPage="@(Model.CurrentPage - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm">← Предишна</a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./Users"
                                   asp-route-currentPage="@i"
                                   asp-route-searchTerm="@Model.SearchTerm">@i</a>
                            </li>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Users"
                                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm">Следваща →</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>